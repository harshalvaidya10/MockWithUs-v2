# ================================
# DATABASE
# ================================
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/mockwithus

# ================================
# AUTH / SECURITY
# ================================
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# ================================
# LLM CONFIG
# ================================
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3-32b

# Groq (required if using groq)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter (optional fallback provider)
# OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama (optional local provider)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional providers (leave empty if unused)
OPENAI_API_KEY=

# ================================
# FILE UPLOAD
# ================================
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=5
MAX_ANSWER_AUDIO_SIZE_MB=10

# ================================
# TRANSCRIPTION
# ================================
TRANSCRIPTION_MODEL_SIZE=base
TRANSCRIPTION_DEVICE=cpu
TRANSCRIPTION_COMPUTE_TYPE=int8

# ================================
# CORS
# ================================
CORS_ORIGINS=http://localhost:3000

# ================================
# ENVIRONMENT
# ================================
ENVIRONMENT=development

# ================================
# CODE EXECUTION SANDBOX
# ================================
# local: run code in-process (test/dev only)
# remote: send execution to isolated executor service
CODE_EXECUTION_MODE=local
CODE_EXECUTOR_URL=http://executor:9000
CODE_EXECUTOR_SHARED_SECRET=change-me
# For local-only troubleshooting. Leave unset in normal/prod setups.
# If set to "1" and CODE_EXECUTOR_SHARED_SECRET is empty, executor allows unauthenticated calls.
CODE_EXECUTOR_ALLOW_UNAUTHENTICATED=0
CODE_EXEC_MEMORY_LIMIT_BYTES=268435456
CODE_EXEC_MAX_PROCESSES=32
CODE_EXEC_MAX_FILE_SIZE_BYTES=33554432
CODE_EXEC_MAX_OPEN_FILES=64
